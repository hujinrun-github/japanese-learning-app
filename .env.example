# Copy to .env.local and use different database names for development and tests.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/japanese_learning_app_dev?sslmode=disable
DATABASE_URL_TEST=postgres://postgres:postgres@localhost:5432/japanese_learning_app_test?sslmode=disable
APP_TIMEZONE=Asia/Shanghai

# Optional FlowSpace task completion integration (all three required to enable).
# Production requires HTTPS; loopback HTTP is allowed for local tests.
FLOWSPACE_BASE_URL=
FLOWSPACE_SOURCE_INSTANCE_ID=
# Generate 32 random bytes as 64 hex characters; keep this stable and private.
FLOWSPACE_INTEGRATION_MASTER_KEY=
